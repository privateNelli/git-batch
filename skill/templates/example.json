{
  "exclude": ["**/*-debug.log", ".env", ".env.local"],
  "batches": [
    {
      "id": "1-fix-scope",
      "message": "fix(scope): short imperative summary\n\nWhy this batch is its own commit.",
      "files": ["src/example.ts"],
      "insertLines": [
        {
          "file": "CHANGELOG.md",
          "insertAfter": "|------|----------|",
          "lines": [
            "| YYYY-MM-DD | fix: one-line summary |"
          ],
          "skipIfIncludes": "fix: one-line summary"
        }
      ]
    },
    {
      "id": "2-feat-other",
      "message": "feat(other): another focused change",
      "files": ["src/other.ts"],
      "skipIfEmpty": true
    }
  ]
}
